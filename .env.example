# Public by design (shipped to the browser). Access is controlled by row-level security.
# Copy to .env.local and fill in. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Better Stack application token (from the application's Frontend tab). Leave empty to send no analytics.
VITE_BETTERSTACK_TOKEN=
